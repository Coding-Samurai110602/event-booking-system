# Copy this file to .env and fill in real values before running docker-compose.
# .env is gitignored; .env.example is committed as the canonical reference.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=bookings
POSTGRES_USER=bookings
POSTGRES_PASSWORD=bookings_secret

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
